# Copy this file to .env.seed and fill it in. NEVER commit .env.seed.
# Used only by `npm run seed` on your machine. The service role key bypasses all
# security rules, so it must never go into the browser app or Vercel.
#
# Hosted Supabase: Project Settings > API (use the "service_role" key, or a "secret" key sb_secret_...)
# Local Supabase:  run `npx supabase status` and use the API URL and the Secret key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
