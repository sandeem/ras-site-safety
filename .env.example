# Copy this file to .env.local for local development.
# On Vercel, add the same two variables under Project Settings > Environment Variables.
#
# These two values are safe to be public: the anon/publishable key can only do what the
# Row Level Security policies allow.
#
# Hosted Supabase: Project Settings > API
# Local Supabase:  `npx supabase status` (API URL and Publishable key)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
